{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,styles.css,public/**,api/**}",
      "maxDuration": 10
    },
    "api/*.js": {
      "maxDuration": 10
    }
  }
}
